// Features a release can be built without, with no code change. Debug builds always have
// them (Config/Debug.xcconfig). This file is the switch: the package manifest reads it too,
// so with NO the code isn't compiled into a release at all. After changing it, run
// scripts/export-agents-guide.sh.
//
// Heal Selection (Edit › Heal Selection, the agent's heal_selection): fills a selected area
// from its surroundings with classic methods, no model. NO until Anders has seen results
// (docs/PATENTS.md has the rules the code keeps to and why). The menu item, /operations,
// the guide, the manual and the FAQ follow this (Config/site-features.json).
GLIMMER_HEAL = NO

// Photoshop files with their layers (File › Open… on a PSD or PSB, the agent API's import,
// File › Import Report…, File › Export… › Photoshop File…). YES since 2026-11-16: eighteen
// files written by Photoshop opened with true reports and survived being cut and changed
// (docs/TESTING-NOTES.md). With NO a release opens a Photoshop file as the flattened picture
// macOS reads from it. The manual, the FAQ and the agent guide follow this.
GLIMMER_PSD = YES

// RAW development (a camera's RAW file opens as a layer that keeps the RAW and can be developed
// again with Layer › Develop… or the agent API's develop_raw, through Apple's own decoder).
// YES since 2026-11-16: Anders looked at pictures developed from six cameras' files and said
// yes (docs/TESTING-NOTES.md has what was tried and what was not). With NO a RAW file opens as
// the system's default rendering. The manual, the FAQ and the agent guide follow this.
GLIMMER_RAW = YES
