// Features a release can be built without, with no code change. Debug builds always have
// them (Config/Debug.xcconfig). This file is the switch: the package manifest reads it too,
// so with NO the code isn't compiled into a release at all. After changing it, run
// scripts/export-agents-guide.sh.
//
// Heal Selection (Edit › Heal Selection, the agent's heal_selection): fills a selected area
// from its surroundings with classic methods, no model. NO until Anders has seen results
// (docs/PATENTS.md has the rules the code keeps to and why). The menu item, /operations,
// the guide, the manual and the FAQ follow this (Config/site-features.json).
GLIMMER_HEAL = NO

// Photoshop files with their layers (File › Open… on a PSD or PSB, the agent API's import,
// File › Import Report…). NO until a file saved by Photoshop itself has met the reader: every
// test file so far comes from Glimmer's own writer, which reads Adobe's specification the way
// the reader does. With NO a release opens a Photoshop file as before, as the flattened
// picture macOS reads from it. The manual and the agent guide follow this.
GLIMMER_PSD = NO

// RAW development (a RAW file opens as a layer that keeps the RAW and can be developed again:
// exposure, white balance and the rest, through Apple's own decoder). NO until Anders has
// looked at a real camera file developed by it. With NO a RAW file opens as before, as the
// system's default rendering. The manual follows this.
GLIMMER_RAW = NO
