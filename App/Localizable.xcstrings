          "stringUnit": {
            "state": "translated",
            "value": "Ger det aktiva lagret en referensbilds färgsättning. Körs på den här Macen."
          }
        }
      }
    },
    "Layers, groups, masks, adjustment layers, layer styles, smart objects and text — non-destructive, in 16-bit linear color.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lager, grupper, masker, justeringslager, lagerstilar, smarta objekt och text – icke-destruktivt, i 16-bitars linjär färg."
