    "JPEG has no transparency: the background turns white. Choose PNG, HEIC or WebP to keep it.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG saknar genomskinlighet, så bakgrunden blir vit. Välj PNG, HEIC eller WebP för att behålla den."
          }
        }
      }
    },
