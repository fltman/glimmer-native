    "Glimmer's support for %@ is built from its documentation and has not been tried with a real call yet. If it answers with an error, Glimmer shows it as it came.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmers stöd för %@ är byggt efter tjänstens dokumentation och har ännu inte provats med ett riktigt anrop. Om tjänsten svarar med ett fel visar Glimmer felet som det kom."
          }
        }
      }
    },
    "Your key is stored in your keychain and sent only to %@.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nyckel sparas i din nyckelring och skickas bara till %@."
          }
        }
      }
    },
    "Get a key": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaffa en nyckel"
          }
        }
      }
    },
    "Terms": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Villkor"
          }
        }
      }
    },
    "Prices": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priser"
          }
        }
      }
    },
    "Model": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        }
      }
    },
    "Choose a model": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en modell"
          }
        }
      }
    },
    "%@ (no longer listed)": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (finns inte längre i listan)"
          }
        }
      }
    },
    "Refresh": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdatera"
          }
        }
      }
    },
    "Loading the model list": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar modellistan"
          }
        }
      }
    },
    "%@ lists this model without tool calls. The Assistant can't use it.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ anger att modellen saknar verktygsanrop. Assistenten kan inte använda den."
          }
        }
      }
    },
    "This model can't take pictures, so the Assistant plans without looking at the document, and suggestions and Find Distractions won't work with it.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kan inte ta emot bilder, så assistenten planerar utan att se dokumentet, och förslag och Hitta störande inslag fungerar inte med den."
          }
        }
      }
    },
    "Billed by %@ at their rates.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Faktureras av %@ enligt deras priser."
          }
        }
      }
    },
    "Choose a %@ model in Settings › AI.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en modell för %@ i Inställningar › AI."
          }
        }
      }
    },
    "%@ can't take pictures, so the Assistant plans without looking at the document.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan inte ta emot bilder, så assistenten planerar utan att se dokumentet."
          }
        }
      }
    },
    "Berget AI runs open models in Stockholm. Its terms say it never stores the content of prompts or answers.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berget AI kör öppna modeller i Stockholm. Enligt villkoren sparas aldrig innehållet i frågor eller svar."
          }
        }
      }
    },
    "Grunden AI runs open models in Sweden and says all processing happens there.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grunden AI kör öppna modeller i Sverige och uppger att all bearbetning sker där."
          }
        }
      }
    },
    "This model can't look at pictures": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här modellen kan inte se bilder"
          }
        }
      }
    },
    "Send this to %@?": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka det här till %@?"
          }
        }
      }
    },
    "You can read this again in Settings › AI.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan läsa det här igen i Inställningar › AI."
          }
        }
      }
    },
    "Suggest Edits and Find Distractions send a picture of the document too.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreslå ändringar och Hitta störande inslag skickar också en bild av dokumentet."
          }
        }
      }
    },
    "%@ bills your key for each request.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fakturerar din nyckel för varje förfrågan."
          }
        }
      }
    },
    "Nothing leaves this Mac and nothing is billed.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget lämnar den här Macen och inget faktureras."
          }
        }
      }
    },
    "Not Now": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte nu"
          }
        }
      }
    },
    "What is sent to %@": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad som skickas till %@"
          }
        }
      }
    },
    "%@ (on this Mac)": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (på den här Macen)"
          }
        }
      }
    },
    "%@ (not evaluated with Glimmer)": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (inte utvärderad med Glimmer)"
          }
        }
      }
    },
    "%@ (not installed)": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (inte installerad)"
          }
        }
      }
    },
    "%@ isn't running on this Mac. Start it, then click Refresh.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kör inte på den här Macen. Starta det och klicka sedan på Uppdatera."
          }
        }
      }
    },
    "None of the models installed in %@ lists tool calls, which the Assistant needs.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av modellerna som är installerade i %@ har verktygsanrop, vilket assistenten behöver."
          }
        }
      }
    },
    "Glimmer has tried %@ with its own test of everyday requests. It gets most of them right; a Swedish request for an adjustment can come back incomplete, and the same request in English works.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmer har provat %@ med sitt eget test av vardagliga uppdrag. Den klarar de flesta; en svensk begäran om en justering kan komma tillbaka ofullständig, och samma begäran på engelska fungerar."
          }
        }
      }
    },
    "Glimmer has not tried %@. It may plan badly or call tools that don't exist; Glimmer drops those and tells you.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmer har inte provat %@. Den kan planera dåligt eller anropa verktyg som inte finns; Glimmer hoppar över sådana och talar om det."
          }
        }
      }
    },
    "This model can't take pictures, so the Assistant plans without looking at the document, and Suggest Edits and Find Distractions won't work with it.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kan inte ta emot bilder, så assistenten planerar utan att se dokumentet, och Föreslå ändringar och Hitta störande inslag fungerar inte med den."
          }
        }
      }
    },
    "Runs on this Mac with Ollama: nothing is sent anywhere and nothing is billed. Slower than a cloud model; an answer can take up to a minute on a busy Mac.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs på den här Macen med Ollama: inget skickas någonstans och inget faktureras. Långsammare än en molnmodell; ett svar kan ta upp till en minut på en upptagen Mac."
          }
        }
      }
    },
    "Glimmer can't use %@ for text yet.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmer kan inte använda %@ för text ännu."
          }
        }
      }
    },
    "You": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du"
          }
        }
      }
    },
    "Suggest Edits and Find Distractions need to see the document, so they don't run with this model.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreslå ändringar och Hitta störande inslag behöver se dokumentet, så de körs inte med den här modellen."
          }
        }
      }
    },
    "Glimmer ran out of memory, so part of the last edit or of the picture on screen may be missing. Undo the last step, close other documents or merge some layers, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmer fick slut på minne, så en del av den senaste ändringen eller av bilden på skärmen kan saknas. Ångra det senaste steget, stäng andra dokument eller slå ihop några lager och försök igen."
          }
        }
      }
    },
    "Glimmer left out a figure it could not verify.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmer utelämnade en siffra som inte gick att kontrollera."
          }
        }
      }
    },
    "Add your OpenRouter API key in Settings › AI to use the assistant.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg in din OpenRouter-nyckel i Inställningar › AI för att använda assistenten."
          }
        }
      }
    },
    "Glimmer calls OpenRouter directly with your own key. It is stored in your keychain and only sent to the service below (openrouter.ai unless you change it). [Get a key](https://openrouter.ai/keys)": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmer anropar OpenRouter direkt med din egen nyckel. Den sparas i din nyckelring och skickas bara till tjänsten nedan (openrouter.ai om du inte ändrar det). [Skaffa en nyckel](https://openrouter.ai/keys)"
          }
        }
      }
    },
    "Not a valid http(s) address; Glimmer uses OpenRouter.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte en giltig http(s)-adress; Glimmer använder OpenRouter."
          }
        }
      }
    },
    "Any service with OpenRouter's API (chat completions with image output) works. Leave empty for OpenRouter. Your key is sent only to this address.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla tjänster med OpenRouters API (chat completions med bild i svaret) fungerar. Lämna tomt för OpenRouter. Din nyckel skickas bara till den här adressen."
          }
        }
      }
    },
    "Leave empty for Hugging Face. A mirror must serve the same paths (<repository>/resolve/main/<file>).": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för Hugging Face. En spegel måste ha samma sökvägar (<repository>/resolve/main/<file>)."
          }
        }
      }
    },
    "Was being edited for %@. %@": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigerades åt %@. %@"
          }
        }
      }
    },
    "Choose %@ again in Settings › AI and confirm what is sent to it.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj %@ igen i Inställningar › AI och bekräfta vad som skickas dit."
          }
        }
      }
    },
    "%@ bills your key for each picture.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debiterar din nyckel för varje bild."
          }
        }
      }
    },
    "Leave empty for the model's id followed by /edit": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för modellens id följt av /edit"
          }
        }
      }
    },
    "Pictures": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder"
          }
        }
      }
    },
    "The model's id, as %@ writes it": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellens id, så som %@ skriver det"
          }
        }
      }
    },
    "Use %@": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd %@"
          }
        }
      }
    },
    "Which service makes and edits pictures: Generate, Edit with Prompt, Generative Fill, Expand and the others.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken tjänst som skapar och redigerar bilder: Generera, Redigera med prompt, Generativ fyllning, Utöka och de andra."
          }
        }
      }
    },
    "Send pictures to %@?": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka bilder till %@?"
          }
        }
      }
    },
    "Model for editing": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell för redigering"
          }
        }
      }
    },
    "Which service answers when the Assistant plans, suggests edits or looks for distractions.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken tjänst som svarar när assistenten planerar, föreslår ändringar eller letar efter störande inslag."
          }
        }
      }
    },
    "I think you mean %@. You didn't name it, so it waits for you.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag tror att du menar %@. Du nämnde det inte, så det väntar på dig."
          }
        }
      }
    },
    "That isn't available right now.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att göra just nu."
          }
        }
      }
    },
    "Some of these steps aren't named in what you asked, so the plan waits for Run.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några av stegen nämns inte i det du bad om, så planen väntar på Kör."
          }
        }
      }
    },
    "Import Report": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importrapport"
          }
        }
      }
    },
    "Import Report…": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importrapport…"
          }
        }
      }
    },
    "Opened as one layer: the file's own flattened picture (%@).": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnad som ett lager: filens egen sammanslagna bild (%@)."
          }
        }
      }
    },
    "Glimmer's picture matches the one saved in the file.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmers bild stämmer med den som är sparad i filen."
          }
        }
      }
    },
    "It was text and is now pixels: the words can't be edited as text.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var text och är nu pixlar: orden går inte att redigera som text."
          }
        }
      }
    },
    "It was a smart object and is now pixels. The file placed in it is not kept in this version.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var ett smart objekt och är nu pixlar. Filen som låg i det sparas inte i den här versionen."
          }
        }
      }
    },
    "Its layer effects (shadows, strokes, glows) were not read.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrets effekter (skuggor, konturer, glöd) lästes inte."
          }
        }
      }
    },
    "Its vector mask was not read; the layer's pixels are shown whole.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrets vektormask lästes inte; lagrets pixlar visas hela."
          }
        }
      }
    },
    "The blend mode %@ became Normal: Glimmer doesn't have it.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandningsläget %@ blev Normal: Glimmer har inte det läget."
          }
        }
      }
    },
    "Its pixels are incomplete in the file, so the layer came in empty.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrets pixlar är ofullständiga i filen, så lagret kom in tomt."
          }
        }
      }
    },
    "The group's end is missing in the file; it came in empty.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppens slut saknas i filen; den kom in tom."
          }
        }
      }
    },
    "A group in the file has no record of its own; its layers came in without the group.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En grupp i filen saknar egen post; dess lager kom in utan gruppen."
          }
        }
      }
    },
    "Glimmer reads the layers of RGB and grayscale files with 8 or 16 bits per channel. This file is %@. Its layers were not read; the picture is the one saved in the file.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glimmer läser lagren i RGB- och gråskalefiler med 8 eller 16 bitar per kanal. Den här filen är %@. Lagren lästes inte; bilden är den som är sparad i filen."
          }
        }
      }
    },
    "The Photoshop file itself is not changed. This is a new Glimmer document, and the report is saved with it: File › Import Report… shows it again.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Själva Photoshop-filen ändras inte. Det här är ett nytt Glimmer-dokument och rapporten sparas med det: Arkiv › Importrapport… visar den igen."
          }
        }
      }
    },
    "It was text (“%@”) and is now pixels: the words can't be edited as text.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var text (”%@”) och är nu pixlar: orden går inte att redigera som text."
          }
        }
      }
    },
    "It is a Curves adjustment with the same points. Between the points the curve may run a little differently than in Photoshop.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är en kurvjustering med samma punkter. Mellan punkterna kan kurvan gå något annorlunda än i Photoshop."
          }
        }
      }
    },
    "It was a %@ adjustment layer. That kind is not read in this version, so it was left out.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var ett justeringslager (%@). Den sorten läses inte i den här versionen, så det lämnades utanför."
          }
        }
      }
    },
    "It was a fill or shape layer (%@). That kind is not read in this version, so it was left out.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var ett fyllnings- eller formlager (%@). Den sorten läses inte i den här versionen, så det lämnades utanför."
          }
        }
      }
    },
    "The assistant also suggests %@, which you didn't ask for. Run it now on the picture as it is?": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenten föreslår också %@, som du inte bad om. Köra det nu på bilden som den är?"
          }
        }
      }
    },
    "It is written as a layer of pixels that looks the same (in Glimmer it is %@).": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det skrivs som ett pixellager som ser likadant ut (i Glimmer är det %@)."
          }
        }
      }
    },
    "It is a %@ adjustment layer, which Glimmer can't write as one. It is not among the file's layers; the flattened picture in the file still shows it.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är ett justeringslager (%@) som Glimmer inte kan skriva som sådant. Det finns inte bland filens lager; den sammanslagna bilden i filen visar det ändå."
          }
        }
      }
    },
    "Its mask is written without its feather and density.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrets mask skrivs utan ludd och täthet."
          }
        }
      }
    },
    "It reaches outside the canvas, and what is outside is not written.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret når utanför arbetsytan, och det som ligger utanför skrivs inte."
          }
        }
      }
    },
    "All layers are merged into one, as chosen: the file looks right everywhere and has no layers to edit.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla lager slås ihop till ett, som du valde: filen ser rätt ut överallt och har inga lager att redigera."
          }
        }
      }
    },
    "Export as Photoshop File": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportera som Photoshop-fil"
          }
        }
      }
    },
    "8 bits per channel": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "8 bitar per kanal"
          }
        }
      }
    },
    "As they are": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som de är"
          }
        }
      }
    },
    "Merged into one layer": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanslagna till ett lager"
