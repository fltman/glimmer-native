            "state": "translated",
            "value": "Det här lagret har ingen RAW-fil som den här datorn kan framkalla."
          }
        }
      }
    },
    "Uses the correction the camera stored in the file. It reshapes the whole picture a little, not only the corners.": {
      "extractionState": "manual",
      "localizations": {
        "sv": {
          "stringUnit": {
